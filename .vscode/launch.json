{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run AgriSense app",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "${workspaceFolder}/app.py", "--server.address", "127.0.0.1"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Retrain all models",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train_models.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
